{
  "name": "fe-grind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive frontend interview practice: quizzes, guess-the-output, coding drills with tests, machine coding with live preview, flashcards and ordering, across JS, TS, React, Next.js, HTML, CSS, DSA, patterns, system design, testing and Node.",
  "scripts": {
    "predev": "npm run architecture",
    "dev": "vite",
    "prebuild": "npm run architecture",
    "build": "tsc -b && vite build && npm run build:ssr && node scripts/prerender.js && node scripts/generate-sitemap.js",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --target node20",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,json,md}\" \"*.{json,md,js,ts}\" --log-level warn",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,json,md}\" \"*.{json,md,js,ts}\" --log-level warn",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run check:contrast && npm test",
    "prepare": "husky",
    "check:contrast": "node scripts/check-contrast.js",
    "icons": "node scripts/generate-icons.js",
    "architecture": "node scripts/generate-architecture.mjs",
    "architecture:check": "node scripts/generate-architecture.mjs --check"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^0.468.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "sucrase": "^3.35.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "fake-indexeddb": "^6.0.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write --ignore-unknown"
    ],
    "*.{md,json}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
