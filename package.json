{
  "name": "fe-grind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive frontend interview practice: quizzes, guess-the-output, coding drills with tests, machine coding with live preview, flashcards and ordering, across JS, TS, React, Next.js, HTML, CSS, DSA, patterns, system design, testing and Node.",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start -w @fe-grind/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check:contrast": "turbo run check:contrast",
    "architecture": "npm run architecture -w @fe-grind/web",
    "architecture:check": "npm run architecture:check -w @fe-grind/web",
    "dsa:traces": "npm run traces -w @fe-grind/dsa",
    "lint:styles": "stylelint \"{apps,packages}/*/src/**/*.{css,scss}\" --allow-empty-input",
    "lint:styles:fix": "stylelint \"{apps,packages}/*/src/**/*.{css,scss}\" --allow-empty-input --fix",
    "format": "prettier --write \"{apps,packages}/*/src/**/*.{ts,tsx,css,scss,json,md}\" \"*.{json,md,js,ts}\" --log-level warn",
    "format:check": "prettier --check \"{apps,packages}/*/src/**/*.{ts,tsx,css,scss,json,md}\" \"*.{json,md,js,ts}\" --log-level warn",
    "check": "turbo run typecheck lint test check:contrast && npm run lint:root && npm run lint:styles",
    "prepare": "husky",
    "lint:root": "eslint \"*.{js,ts}\" scripts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "fake-indexeddb": "^6.0.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write --ignore-unknown"
    ],
    "*.{md,json}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
