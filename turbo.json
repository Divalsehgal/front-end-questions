{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "generate": {
      "inputs": ["scripts/**", "src/**", "!src/generated/**"],
      "outputs": ["src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^generate", "generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "build": {
      "dependsOn": ["^generate", "generate"],
      "env": ["SITE_URL", "GOOGLE_SITE_VERIFICATION", "NEXT_PUBLIC_GTM_ID", "VERCEL_*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^generate", "generate"]
    },
    "test:coverage": {
      "dependsOn": ["^generate", "generate"],
      "outputs": ["coverage/**"]
    },
    "check:contrast": {},
    "architecture:check": {
      "cache": false
    }
  }
}
