{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "esModuleInterop": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "src", ".next/types/**/*.ts", "next.config.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["src/content/subjects/*/files/**", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"]
}
