{
  "name": "@fe-grind/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FE Grind, the Next.js app: routes, metadata, screens, question views and learner state.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-build.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "architecture": "node scripts/generate-architecture.mjs",
    "architecture:check": "node scripts/generate-architecture.mjs --check",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@fe-grind/content": "*",
    "@fe-grind/dsa": "*",
    "@fe-grind/runtime": "*",
    "@fe-grind/ui": "*",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "^3.35.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.2.2"
  }
}
